# API listener. Use 0.0.0.0 inside a container.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3002
# Public frontend origin; production requires HTTPS.
APP_URL=http://localhost:3001

# Matches the root Docker Compose database and Redis ports.
DATABASE_URL=postgresql://reclaim:reclaim-local-only@127.0.0.1:54330/reclaim
REDIS_URL=redis://127.0.0.1:63790
# Use a distinct prefix for each environment sharing Redis.
REDIS_PREFIX=reclaim

# Development file storage and file-delivery email directory.
LOCAL_DATA_DIR=../../.local
# s3 for AWS storage; local for development without AWS.
STORAGE_PROVIDER=s3

# smtp (Nodemailer), ses (AWS), or file (development only).
MAIL_PROVIDER=smtp
# The API processes email automatically. Set false for a separate mail worker.
MAIL_WORKER_ENABLED=true
# Gmail requires an app password. Port 587 uses STARTTLS; 465 uses TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=your-address@gmail.com
# Required only for MAIL_PROVIDER=ses: use an SES-verified sender.
SES_FROM=

# S3 and SES use the AWS SDK credential chain. Prefer IAM roles in production.
AWS_REGION=ap-south-1
# Replace with your existing bucket. S3_BUCKET is an alternative name;
# do not configure the two names with different values.
BUCKET_NAME=your-reclaim-bucket
# Optional with an IAM role or configured AWS profile. Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Needed only for temporary AWS credentials.
AWS_SESSION_TOKEN=

# Bedrock photo-to-item suggestions. No Marketplace endpoint is configured.
# Fill in your Bedrock bearer key; the standard AWS_BEARER_TOKEN_BEDROCK
# alias is supported, but this application-specific key takes precedence.
AWS_BEDROCK_API_KEY=
# Set false for development without AI; manual listing remains available.
BEDROCK_AGENT_ENABLED=true
AWS_BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
# Supported ranges: tokens 256-4096; temperature 0-1.
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.1

# Production also requires HTTPS APP_URL, database TLS, S3, and SMTP or SES.
# Local Docker database credentials above are for development only.
