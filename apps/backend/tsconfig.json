{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"]
}
