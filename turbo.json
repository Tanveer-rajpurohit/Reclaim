{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "APP_URL",
    "DATABASE_URL",
    "STORAGE_PROVIDER",
    "MAIL_PROVIDER",
    "LOCAL_DATA_DIR",
    "AWS_REGION",
    "S3_BUCKET",
    "SES_FROM",
    "BACKEND_PORT",
    "BACKEND_HOST",
    "BACKEND_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build",
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    }
  }
}
