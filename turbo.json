{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "APP_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "REDIS_PREFIX",
    "MAIL_WORKER_ENABLED",
    "STORAGE_PROVIDER",
    "MAIL_PROVIDER",
    "LOCAL_DATA_DIR",
    "AWS_REGION",
    "S3_BUCKET",
    "BUCKET_NAME",
    "BEDROCK_AGENT_ENABLED",
    "BEDROCK_CREDITS_CONFIRMED",
    "AWS_BEDROCK_API_KEY",
    "AWS_BEARER_TOKEN_BEDROCK",
    "AWS_BEDROCK_MODEL_ID",
    "AGENT_MAX_TOKENS",
    "AGENT_TEMPERATURE",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USERNAME",
    "SMTP_PASSWORD",
    "SMTP_FROM_EMAIL",
    "SES_FROM",
    "TEST_DATABASE_URL",
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
    "NEXT_DIST_DIR",
    "BACKEND_URL",
    "BACKEND_PORT",
    "BACKEND_HOST"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    }
  }
}
